# Operational (transactional) DB — the authoritative write target.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/block_planning

# Read Store — separate, read-optimized database holding denormalized
# projections (architecture Section 8). Populated by the polling ETL
# (db/readstore/etl.py); migrated via `alembic -c db/readstore/alembic.ini`.
# Used by the ETL (write) and the Query Service (Phase 7, read).
READ_STORE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/block_planning_read
