PORT=8002
# Read Store (separate, read-optimized DB). Must match db/readstore/session.py,
# which reads READ_STORE_URL at import time.
READ_STORE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/block_planning_read
REDIS_URL=redis://localhost:6379/0
# Cache TTL (seconds) for Read Store results held in Redis.
CACHE_TTL_SECONDS=60
